<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.video-transfer-channel.source-login-helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>__REPO_ROOT__/scripts/source_login_helper.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>5191</string>
        <string>--cookie-dir</string>
        <string>__REPO_ROOT__/cookies</string>
        <string>--profile-dir</string>
        <string>__REPO_ROOT__/config/source-login-profiles</string>
        <string>--secret-file</string>
        <string>__REPO_ROOT__/config/source_login_helper_secret</string>
        <string>--success-url</string>
        <string>https://transfer.sg99.online/transfer-center</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/source-login-helper.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/source-login-helper-error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
